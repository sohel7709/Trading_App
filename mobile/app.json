{
  "expo": {
    "name": "Trade Lab",
    "slug": "zerodha-kite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tradelab.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow TradeLab to use the camera to scan KYC documents and capture your profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow TradeLab to access your photos to upload KYC documents and your profile photo.",
        "NSPhotoLibraryAddUsageDescription": "Allow TradeLab to save downloaded statements and reports to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.tradelab.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TradeLab to use the camera to scan KYC documents and capture your profile photo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TradeLab to access your photos to upload KYC documents and your profile photo."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TradeLab to access your media to upload and save statements.",
          "savePhotosPermission": "Allow TradeLab to save downloaded statements and reports.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "https://backend-api-production-88b1.up.railway.app",
      "eas": {
        "projectId": "f83a41b9-d1f9-4f56-8f0f-fea76d8c078f"
      }
    },
    "owner": "sohel9730",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    }
  }
}
