DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/zerodha?retryWrites=true&w=majority
PORT=8080
# Set to "production" on Railway so dev-only seed endpoints are disabled
NODE_ENV=production

# Kotak Neo Trade API Configuration
KOTAK_NEO_CONSUMER_KEY=your_consumer_key
KOTAK_NEO_CONSUMER_SECRET=your_consumer_secret
KOTAK_NEO_MOBILE_NO=your_registered_mobile
KOTAK_NEO_PASSWORD=your_password
KOTAK_NEO_MPIN=your_mpin
